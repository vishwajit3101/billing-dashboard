{
  "Comment": "Billing Watch pipeline: billing_fetcher (:00) + posthog_processor (:05) in parallel, then risk_calculator, then alert_engine. ARNs injected by Terraform templatefile().",
  "StartAt": "ParallelFetch",
  "States": {
    "ParallelFetch": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "BillingFetcher",
          "States": {
            "BillingFetcher": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${fetch_billing_arn}",
                "Payload": {}
              },
              "ResultSelector": {
                "StatusCode.$": "$.StatusCode",
                "Payload.$": "$.Payload"
              },
              "ResultPath": "$.billingResult",
              "Retry": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "IntervalSeconds": 60,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.billingError",
                  "Next": "BillingFetcherFailed"
                }
              ],
              "End": true
            },
            "BillingFetcherFailed": {
              "Type": "Pass",
              "Result": { "error": "Billing fetcher failed after retries" },
              "End": true
            }
          }
        },
        {
          "StartAt": "WaitFiveMinutes",
          "States": {
            "WaitFiveMinutes": {
              "Type": "Wait",
              "Seconds": 300,
              "Next": "PosthogProcessor"
            },
            "PosthogProcessor": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${fetch_posthog_arn}",
                "Payload": {}
              },
              "ResultSelector": {
                "StatusCode.$": "$.StatusCode",
                "Payload.$": "$.Payload"
              },
              "ResultPath": "$.posthogResult",
              "Retry": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "IntervalSeconds": 60,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.posthogError",
                  "Next": "PosthogProcessorFailed"
                }
              ],
              "End": true
            },
            "PosthogProcessorFailed": {
              "Type": "Pass",
              "Result": { "error": "PostHog processor failed after retries" },
              "End": true
            }
          }
        }
      ],
      "Next": "RiskCalculator",
      "ResultPath": "$.parallelResults",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.parallelError",
          "Next": "PipelineFailed"
        }
      ]
    },
    "RiskCalculator": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${compute_usage_arn}",
        "Payload": {}
      },
      "ResultSelector": {
        "StatusCode.$": "$.StatusCode",
        "Payload.$": "$.Payload"
      },
      "ResultPath": "$.riskResult",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 90,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.riskError",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "AlertEngine"
    },
    "AlertEngine": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${check_alerts_arn}",
        "Payload": {}
      },
      "ResultSelector": {
        "StatusCode.$": "$.StatusCode",
        "Payload.$": "$.Payload"
      },
      "ResultPath": "$.alertResult",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.alertError",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "PipelineSucceeded"
    },
    "PipelineSucceeded": {
      "Type": "Succeed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "BillingWatchPipelineFailed",
      "Cause": "One or more steps failed (see execution output)"
    }
  }
}
