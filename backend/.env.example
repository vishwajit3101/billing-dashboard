# =============================================================================
# Billing Watch Backend — Environment template
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (RDS / PostgreSQL)
# Use RDS_* or DB_*; config prefers RDS_* for host/port/db/user/password.
# -----------------------------------------------------------------------------
RDS_HOST=localhost
RDS_PORT=5432
RDS_DB=billing_watch
RDS_USER=postgres
RDS_PASSWORD=

# Alternative names (used by Lambda / Secrets Manager when RDS_* not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=billing_watch
# DB_USER=postgres
# DB_PASSWORD=

# In AWS Lambda, set DB_SECRET_ARN to Secrets Manager secret ARN (overrides above)
# DB_SECRET_ARN=arn:aws:secretsmanager:region:account:secret:name

# -----------------------------------------------------------------------------
# API keys (tool billing / usage)
# Leave empty to use mocks or skip that provider.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
FULLENRICH_API_KEY=
BUYERCADDY_API_KEY=
POSTHOG_API_KEY=

# PostHog project (required for real event counts)
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com

# -----------------------------------------------------------------------------
# AWS
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# SES (alerts)
SES_EMAIL_FROM=alerts@operator.ai
# Alternative names used by alert engine
# ALERT_FROM_EMAIL=alerts@operator.ai
# ALERT_TO_EMAIL=admin@operator.ai

# -----------------------------------------------------------------------------
# Config (budget & alerts)
# -----------------------------------------------------------------------------
MONTHLY_AWS_BUDGET=12000
ALERT_EMAIL=admin@operator.ai

# Optional: same as ALERT_EMAIL for recipient of SES alerts
# ALERT_TO_EMAIL=admin@operator.ai
